    {
      "text": "Add 4 medium eggs and 5 g vanilla extract. Mix 30 sec / speed 4. Mixture may look slightly curdled.",
      "actions": [
        {
          "match": "30 sec / speed 4",
          "time": 30,
          "speed": "4"
        }
      ],
      "ingredientLinks": [
